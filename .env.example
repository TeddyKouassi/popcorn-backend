# ==========================================
# CONFIGURATION SERVEUR & ENVIRONNEMENT
# ==========================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# En production, définir toutes les origines frontend autorisées, séparées par des virgules.
CORS_ORIGINS=http://localhost:5173

# ==========================================
# BASE DE DONNÉES PRISMA (SQLite en dev local)
# ==========================================
DATABASE_URL="file:./dev.db"

# ==========================================
# SÉCURITÉ JWT
# ==========================================
# Générer une valeur longue, aléatoire et unique par environnement.
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ==========================================
# ADMINISTRATION PAR DÉFAUT (Pour seed.js)
# ==========================================
ADMIN_DEFAULT_NAME="Administrateur PopCorn"
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

ADMIN_DEFAULT_PHONE="+22900000000"

# ==========================================
# CONTACT & NOTIFICATIONS OFFICIELLES
# ==========================================
OFFICIAL_WHATSAPP_NUMBER="2290000000000"
OFFICIAL_CONTACT_EMAIL="contact@example.com"

# ==========================================
# SERVICES TIERS (Non branchés sans autorisation)
# Actuellement en mode simulation locale
# ==========================================
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PopCorn <no-reply@popcorn.bj>"

PAYMENT_GATEWAY_ENABLED=false
FEDAPAY_SECRET_KEY=
KKIAPAY_SECRET_KEY=

# ==========================================
# PASSERELLE DE PAIEMENT SASPAY (Bénin / UEMOA)
# MTN Mobile Money, Moov Money, Celtiis Cash, Cartes
# ==========================================
SASPAY_ENABLED=false
# Ne passer à true qu'après validation complète en sandbox.
SASPAY_API_CONTRACT_CONFIRMED=false
# URL et mécanisme d'authentification indiqués par la documentation SasPay de votre compte.
# Ne pas utiliser une URL trouvée sur Internet sans confirmation écrite de SasPay.
SASPAY_BASE_URL=
# Clé API serveur fournie par SasPay (jamais dans le frontend).
SASPAY_SECRET_KEY=
# Secret webhook seulement si SasPay confirme une signature HMAC compatible.
SASPAY_WEBHOOK_SECRET=
# "disabled" tant que le format officiel de signature n'est pas confirmé.
# Valeur actuellement supportée après confirmation : hmac-sha256-timestamped
SASPAY_WEBHOOK_VERIFICATION_MODE=disabled
