# ==========================================
# CONFIGURATION SERVEUR & ENVIRONNEMENT
# ==========================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ==========================================
# BASE DE DONNÉES PRISMA (SQLite en dev local)
# ==========================================
DATABASE_URL="file:./dev.db"

# ==========================================
# SÉCURITÉ JWT
# ==========================================
JWT_SECRET=super_secret_jwt_key_popcorn_2026_dev_only_change_in_production
JWT_EXPIRES_IN=7d

# ==========================================
# ADMINISTRATION PAR DÉFAUT (Pour seed.js)
# ==========================================
ADMIN_DEFAULT_NAME="Administrateur PopCorn"
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

ADMIN_DEFAULT_PHONE="+22900000000"

# ==========================================
# CONTACT & NOTIFICATIONS OFFICIELLES
# ==========================================
OFFICIAL_WHATSAPP_NUMBER="2290000000000"
OFFICIAL_CONTACT_EMAIL="contact@example.com"

# ==========================================
# SERVICES TIERS (Non branchés sans autorisation)
# Actuellement en mode simulation locale
# ==========================================
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PopCorn <no-reply@popcorn.bj>"

PAYMENT_GATEWAY_ENABLED=false
FEDAPAY_SECRET_KEY=
KKIAPAY_SECRET_KEY=
