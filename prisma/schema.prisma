generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  phone        String?
  password     String
  role         String   @default("CUSTOMER") // "CUSTOMER" ou "ADMIN"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders       Order[]

  @@map("users")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())

  products    Product[]

  @@map("categories")
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  price       Int         // Montant en FCFA
  format      String      @default("Grand format")
  description String
  image       String      // Chemin relatif ou URL
  badge       String?     // "Best-seller", "Gourmand", etc.
  stock       Int         @default(50)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  categoryId  Int
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]

  @@map("products")
}

model Order {
  id            Int         @id @default(autoincrement())
  orderNumber   String      @unique // Ex: "POP-2026-1001"
  customerName  String
  customerPhone String
  customerEmail String?
  city          String
  address       String
  note          String?
  subtotal      Int         // Sous-total produits en FCFA
  shippingFee   Int         @default(0) // Frais de livraison en FCFA
  total         Int         // Montant total en FCFA
  status        String      @default("PENDING") // PENDING, CONFIRMED, PREPARING, SHIPPING, DELIVERED, CANCELLED
  paymentStatus String      @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  paymentMethod String      @default("CASH_ON_DELIVERY") // CASH_ON_DELIVERY, MOBILE_MONEY, CARD, WHATSAPP
  paymentRef    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  userId        Int?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  invoice       Invoice?

  @@map("orders")
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  productName String
  unitPrice   Int      // Prix unitaire au moment de la commande
  quantity    Int
  total       Int      // unitPrice * quantity

  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model Invoice {
  id            Int      @id @default(autoincrement())
  invoiceNumber String   @unique // Ex: "FAC-2026-1001"
  pdfPath       String?  // Chemin relatif vers le fichier PDF
  totalAmount   Int      // Montant facturé en FCFA
  issuedAt      DateTime @default(now())

  orderId       Int      @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String   // "commande", "produits", "livraison", "question", etc.
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}
